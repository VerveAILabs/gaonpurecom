rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Admin users collection - manage admin access
    match /admin_users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId && (
        request.auth.token.email == 'rds087@gmail.com' || 
        request.auth.token.email == 'admin@gaonpure.com' || 
        request.auth.token.email == 'gaonpure01@gmail.com' || 
        request.auth.token.email == 'khiladi14290@gmail.com'
      );
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      // Allow users to update only safe fields; admins can update anything
      allow update: if (request.auth != null && request.auth.uid == userId &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email', 'createdAt']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      // Allow users to list ONLY their own orders; admins can list all
      allow list: if request.auth != null && (
        (request.query.limit <= 100 && request.auth.uid == resource.data.userId) || isAdmin()
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAdmin();
    }

    match /analytics/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
