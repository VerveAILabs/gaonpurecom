{
  "name": "gaon-pure-ecom",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:storefront": "npm run dev --workspace=@gaonpure/storefront",
    "dev:admin": "npm run dev --workspace=@gaonpure/admin-portal",
    "dev:b2b": "npm run dev --workspace=@gaonpure/storefront-b2b",
    "build:storefront": "npm run build --workspace=@gaonpure/storefront",
    "build:admin": "npm run build --workspace=@gaonpure/admin-portal",
    "build:b2b": "npm run build --workspace=@gaonpure/storefront-b2b",
    "build:all": "npm run build:storefront; npm run build:admin; npm run build:b2b",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "prisma:seed": "node scripts/seed-postgres.mjs",
    "use:staging": "firebase use staging",
    "use:prod": "firebase use production",
    "dev": "npm run dev:storefront",
    "build": "npm run build:all",
    "start": "npm run start --workspace=@gaonpure/storefront",
    "lint": "eslint",
    "seed:products": "node scripts/seed-products.mjs",
    "emulators": "firebase emulators:start --only auth,firestore,functions,storage",
    "predeploy:functions": "npm --prefix functions run build",
    "deploy:staging:admin": "firebase deploy --only apphosting:gaonpure-admin --project staging",
    "deploy:staging:storefront": "firebase deploy --only apphosting:gaonpurebackend --project staging",
    "deploy:staging:b2b": "firebase deploy --only apphosting:gaonpure-b2b --project staging",
    "deploy:staging:all": "firebase deploy --only apphosting --project staging",
    "deploy:prod:admin": "firebase deploy --only apphosting:gaonpure-admin --project production",
    "deploy:prod:storefront": "firebase deploy --only apphosting:gaonpurebackend --project production",
    "deploy:prod:all": "firebase deploy --only apphosting --project production",
    "deploy:functions": "npm run predeploy:functions && firebase deploy --only functions",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:safe": "npm run predeploy:functions && firebase deploy --only functions,hosting",
    "deploy": "npm run deploy:safe"
  },
  "dependencies": {
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "firebase": "^11.3.1",
    "framer-motion": "^12.37.0",
    "lucide-react": "^0.460.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "firebase-admin": "^13.7.0",
    "prisma": "^6.19.3",
    "razorpay": "^2.9.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4"
  }
}
